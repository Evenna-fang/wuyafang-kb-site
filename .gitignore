# 上云知识资产仓库 —— 只含可公开的知识/展示内容，排除敏感与垃圾
# 敏感/密钥 —— 绝不入库
*.env
secrets.env
*credential*
*secret*
*.pem
*.key

# 临时/备份/日志垃圾
*.bak
*.bak-*
*.backup*
*.log
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
node_modules/

# 大文件/模型/数据（不入 git，上云走 Zilliz 或对象存储）
*.vhdx
models/
*.bin
*.pt
*.safetensors
*.gguf

# 临时产物
*.tmp
*.temp
.DS_Store
Thumbs.db

# 备份目录不入库
.bak-*/
*/.bak-*/
